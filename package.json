{
  "name": "@artesa/feathers-google-maps",
  "version": "2.0.2",
  "description": "Feathers services for Google Maps Platform: Places API (New), Routes API and Weather API, and the legacy web services",
  "keywords": [
    "feathers",
    "google maps",
    "places",
    "routes",
    "weather"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./legacy": {
      "types": "./dist/legacy.d.ts",
      "import": "./dist/legacy.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">= 24.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.3",
      "onFail": "download"
    }
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "src/**",
    "dist/**"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artesa/feathers-google-maps.git"
  },
  "author": "Artesa",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/artesa/feathers-google-maps/issues"
  },
  "homepage": "https://github.com/artesa/feathers-google-maps#readme",
  "peerDependencies": {
    "@feathersjs/errors": "^5.0.1",
    "@feathersjs/feathers": "^5.0.1",
    "@googlemaps/google-maps-services-js": "^3.3.28"
  },
  "peerDependenciesMeta": {
    "@googlemaps/google-maps-services-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@feathers-community/eslint-config": "^0.3.0",
    "@feathersjs/errors": "^5.0.50",
    "@feathersjs/feathers": "^5.0.50",
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "prettier": "^3.10.1",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "prettier": "@feathers-community/eslint-config/prettier",
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
