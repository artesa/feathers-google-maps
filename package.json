{
  "name": "@artesa/feathers-google-maps",
  "version": "2.0.2",
  "description": "Feathers services for Google Maps Platform: Places API (New), Routes API and Weather API, and the legacy web services",
  "keywords": [
    "feathers",
    "google maps",
    "places",
    "routes",
    "weather"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./legacy": {
      "types": "./dist/legacy.d.ts",
      "import": "./dist/legacy.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">= 22.0.0"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "src/**",
    "dist/**"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artesa/feathers-google-maps.git"
  },
  "author": "Nils Bergmann <contact+feathers-google-maps@noim.net>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/artesa/feathers-google-maps/issues"
  },
  "homepage": "https://github.com/artesa/feathers-google-maps#readme",
  "peerDependencies": {
    "@feathersjs/errors": "^5.0.1",
    "@feathersjs/feathers": "^5.0.1",
    "@googlemaps/google-maps-services-js": "^3.3.28"
  },
  "peerDependenciesMeta": {
    "@googlemaps/google-maps-services-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@feathersjs/errors": "^5.0.1",
    "@feathersjs/feathers": "^5.0.1",
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "@types/node": "^22.15.19",
    "tsdown": "^0.11.11",
    "typescript": "^5.0.3",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977"
}
